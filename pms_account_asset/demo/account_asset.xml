<?xml version="1.0" encoding="UTF-8" ?>
<odoo noupdate="1">
    <record id="demo_account_asset" model="account.account">
        <field name="name">PMS demonstration fixed assets</field>
        <field name="code">PMS100</field>
        <field name="account_type">asset_fixed</field>
    </record>
    <record id="demo_account_depreciation" model="account.account">
        <field name="name">PMS demonstration accumulated depreciation</field>
        <field name="code">PMS110</field>
        <field name="account_type">asset_fixed</field>
    </record>
    <record id="demo_account_depreciation_expense" model="account.account">
        <field name="name">PMS demonstration depreciation expense</field>
        <field name="code">PMS600</field>
        <field name="account_type">expense_depreciation</field>
    </record>
    <record id="demo_asset_journal" model="account.journal">
        <field name="name">PMS demonstration depreciation</field>
        <field name="code">PMSD</field>
        <field name="type">general</field>
    </record>
    <record id="demo_asset_profile" model="account.asset.profile">
        <field name="name">PMS demonstration property equipment</field>
        <field name="account_asset_id" ref="demo_account_asset" />
        <field name="account_depreciation_id" ref="demo_account_depreciation" />
        <field
            name="account_expense_depreciation_id"
            ref="demo_account_depreciation_expense"
        />
        <field name="journal_id" ref="demo_asset_journal" />
    </record>

    <record id="demo_asset_downtown_furniture" model="account.asset">
        <field name="name">Downtown Apartment – Furniture Set</field>
        <field name="profile_id" ref="demo_asset_profile" />
        <field name="date_start" eval="datetime.now().strftime('%Y-%m-%d')" />
        <field name="property_id" ref="pms_base.demo_property_downtown" />
        <field name="purchase_value">8000.0</field>
    </record>

    <record id="demo_asset_suburban_appliances" model="account.asset">
        <field name="name">Suburban House – Kitchen Appliances</field>
        <field name="profile_id" ref="demo_asset_profile" />
        <field name="date_start" eval="datetime.now().strftime('%Y-%m-%d')" />
        <field name="property_id" ref="pms_base.demo_property_suburban" />
        <field name="purchase_value">5500.0</field>
    </record>

    <record id="demo_asset_suburban_hvac" model="account.asset">
        <field name="name">Suburban House – HVAC System</field>
        <field name="profile_id" ref="demo_asset_profile" />
        <field name="date_start" eval="datetime.now().strftime('%Y-%m-%d')" />
        <field name="property_id" ref="pms_base.demo_property_suburban" />
        <field name="purchase_value">12000.0</field>
    </record>
</odoo>
